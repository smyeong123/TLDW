# Copy to .env and fill in. .env is git-ignored.

# Anthropic API key (used for topic classification and script generation)
ANTHROPIC_API_KEY=

# Telegram delivery (only needed if "telegram" is in config.yaml delivery list)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Path to the OAuth client secret JSON downloaded from Google Cloud Console
# (Desktop app client). Defaults to ./client_secret.json
GOOGLE_CLIENT_SECRET_FILE=client_secret.json

# Where the OAuth token is stored after `tldw auth`. Defaults to ./token.json
GOOGLE_TOKEN_FILE=token.json

# Shared secret between the browser extension and `tldw serve`. Any long random string;
# paste the same value into the extension's options page. e.g. `openssl rand -hex 24`
TLDW_EXTENSION_TOKEN=
