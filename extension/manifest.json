{
  "manifest_version": 3,
  "name": "TLDW — Watch Later sender",
  "version": "0.1.0",
  "description": "Sends your Watch Later list and how much of each video you watched to the local TLDW CLI.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://www.youtube.com/*", "http://127.0.0.1/*"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["parse.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "TLDW" },
  "options_ui": { "page": "options.html", "open_in_tab": false }
}
